model LeaveRequest {
  id           String    @id @default(uuid())
  employeeId   String
  leaveType    String    // CASUAL, SICK, EARNED, UNPAID, OTHER
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  daysCount    Float
  reason       String
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  actionById   String?
  actionAt     DateTime?
  actionNotes  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
}

model EmployeeLeaveBalance {
  id           String   @id @default(uuid())
  employeeId   String
  year         Int      // e.g. 2026
  leaveType    String   // CASUAL, SICK, EARNED
  totalDays    Float    // allocated days per year (e.g. 12 Casual, 10 Sick, 15 Earned)
  usedDays     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, leaveType])
  @@index([employeeId])
  @@index([year])
}

