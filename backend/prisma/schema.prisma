  companyName          String   @default("UTC Travel & Tourism")
  supportEmail         String   @default("support@utctravel.com")
  supportPhone         String   @default("+1 (800) 555-UTC1")
  whatsappNumber       String?
  currency             String   @default("USD")
  timezone             String   @default("UTC+03:00")
  notificationsEnabled Boolean  @default(true)
  autoAssignEnquiries  Boolean  @default(true)
  officeStartTime      String   @default("09:30")
  officeEndTime        String   @default("18:30")
  breakStartTime       String?  @default("13:00")
  breakEndTime         String?  @default("14:00")
  gracePeriodMins      Int      @default(15)
