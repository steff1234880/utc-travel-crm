  passwordMinLength   Int      @default(8)
  requireUppercase    Boolean  @default(true)
  requireLowercase    Boolean  @default(true)
  requireNumbers      Boolean  @default(true)
  requireSpecialChars Boolean  @default(true)
  sessionTimeoutMins  Int      @default(120)
  maxLoginAttempts    Int      @default(5)
  lockoutDurationMins Int      @default(15)
  auditLoggingEnabled Boolean  @default(true)
  maxFileUploadMb     Int      @default(10)
  allowedFileTypes    String   @default("pdf,doc,docx,jpg,jpeg,png,webp,csv,xlsx")
