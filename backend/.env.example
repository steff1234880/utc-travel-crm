# ==========================================
# UTC Travel CRM - Environment Variables Template
# ==========================================
# DO NOT ADD REAL SECRETS HERE. 
# Copy this to .env and configure for your environment.

# --------------------------
# Server Configuration
# --------------------------
PORT=5000
NODE_ENV=development # development, testing, production
CLIENT_URL=http://localhost:3000

# --------------------------
# Database Configuration
# --------------------------
# Local PostgreSQL connection string:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/utctravel?schema=public"
# Neon PostgreSQL (Direct connection):
# DATABASE_URL="postgresql://<user>:<password>@<ep-xxxx>.region.aws.neon.tech/<dbname>?sslmode=require"
# Neon PostgreSQL (Connection pooler with PgBouncer):
# DATABASE_URL="postgresql://<user>:<password>@<ep-xxxx>-pooler.region.aws.neon.tech/<dbname>?sslmode=require&pgbouncer=true"

# --------------------------
# Authentication & Security
# --------------------------
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_EXPIRES_IN=1d

# --------------------------
# File Uploads (Optional/Future)
# --------------------------
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --------------------------
# External Services
# --------------------------
# STRIPE_SECRET_KEY=
# SENDGRID_API_KEY=

# --------------------------
# Meta Business Suite Integration
# --------------------------
# Meta Graph API Version (Default LTS: v21.0)
META_GRAPH_API_VERSION="v21.0"

# Fixed 32-byte secret for AES-256-GCM token encryption
META_ENCRYPTION_SECRET="generate_a_secure_persistent_32_character_secret"

# Meta Webhook Challenge Verification Token
META_VERIFY_TOKEN="generate_secure_webhook_verify_token"

# Optional Server-level Meta Credentials (or configure in Admin UI)
META_APP_ID=""
META_APP_SECRET=""
META_PIXEL_ID=""
META_CAPI_TOKEN=""
