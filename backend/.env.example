# ==========================================
# UTC Travel CRM - Environment Variables Template
# ==========================================
# DO NOT ADD REAL SECRETS HERE. 
# Copy this to .env and configure for your environment.

# --------------------------
# Server Configuration
# --------------------------
PORT=5000
NODE_ENV=development # development, testing, production
CLIENT_URL=http://localhost:3000

# --------------------------
# Database Configuration
# --------------------------
# Local PostgreSQL connection string:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/utctravel?schema=public"
# Neon PostgreSQL (Direct connection):
# DATABASE_URL="postgresql://<user>:<password>@<ep-xxxx>.region.aws.neon.tech/<dbname>?sslmode=require"
# Neon PostgreSQL (Connection pooler with PgBouncer):
# DATABASE_URL="postgresql://<user>:<password>@<ep-xxxx>-pooler.region.aws.neon.tech/<dbname>?sslmode=require&pgbouncer=true"

# --------------------------
# Authentication & Security
# --------------------------
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_EXPIRES_IN=1d

# --------------------------
# File Uploads (Optional/Future)
# --------------------------
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --------------------------
# External Services
# --------------------------
# STRIPE_SECRET_KEY=
# SENDGRID_API_KEY=
